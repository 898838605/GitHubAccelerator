# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 构建产物（可用 pyinstaller GitHubHostsAccelerator.spec 重新生成）
build/
dist/

# 运行时数据：由程序自动生成，不纳入版本库（避免每次运行都产生 diff）
app.log*
config.json
config.json.bad
github_hosts.txt

# 运行时生成的图标（构建时如需图标，可把 icon.ico 放本地项目根）
icon.png

# Windows 组件缓存误落到仓库时的兜底（非项目文件）
%SystemDrive%/

# 单元测试仅在本地保留，不随仓库发布
tests/

# 工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 本地审查报告（不发布到公开仓库）
docs/优化方案.md

# 打包与 CI 配置：仅本地保留，不随仓库发布
GitHubHostsAccelerator.spec
version_info.txt
icon.ico
.github/
