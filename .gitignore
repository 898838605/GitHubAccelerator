# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 构建产物（可用 pyinstaller GitHubHostsAccelerator.spec 重新生成）
build/
dist/

# 运行时数据：由程序自动生成，不纳入版本库（避免每次运行都产生 diff）
app.log*
config.json
config.json.bad
github_hosts.txt

# 运行时生成的图标（icon.ico 作为构建输入保留在仓库中）
icon.png

# Windows 组件缓存误落到仓库时的兜底（非项目文件）
%SystemDrive%/

# 工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 本地审查报告（不发布到公开仓库）
docs/优化方案.md
